# --- Database / cache ---
POSTGRES_USER=kalpa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kalpa
DATABASE_URL=postgresql+asyncpg://kalpa:change-me@localhost:5432/kalpa
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# ENVIRONMENT=prod makes the API refuse to start with the built-in dev JWT secrets.
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=dev
COOKIE_SECURE=false   # set true behind HTTPS
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# --- Web / CORS ---
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- MLOps ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Optional (copilot works without it) ---
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-haiku-5-5

# --- Build metadata ---
GIT_SHA=dev
